{
  "name": "help-center",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs --assets",
    "check:icons": "node scripts/generate-icons.mjs --check-server=../server/internal/iconcatalog/catalog_generated.go --check-frontend-alias=../frontend/src/generated/iconAliases.ts",
    "predev": "pnpm generate:icons",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "prebuild": "pnpm generate:icons",
    "build": "tsc -b && vite build && node scripts/compress-assets.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@scalar/api-reference-react": "0.9.62",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "redis": "^5.12.1",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@hugeicons/core-free-icons": "4.1.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
