# Community 0.2 beta. setup.sh install generates independent persistent secrets.
COMPOSE_PROJECT_NAME=helpin-community
HELPIN_VERSION=community-v0.2.0-rc.1
AGENT_RUNTIME_VERSION=community-v0.2.0-rc.1
# All published ports bind loopback. A public HTTPS proxy forwards to these.
BIND_ADDRESS=127.0.0.1
# Exact address/CIDR of a trusted external proxy as seen by the ingress container.
# Local evaluation does not need forwarded headers. Do not use 0.0.0.0/0.
COMMUNITY_TRUSTED_PROXY_CIDR=127.0.0.1/32
# Server mode HTTPS: builtin runs the bundled Caddy proxy (compose.proxy.yaml);
# external means you run your own reverse proxy. Empty for local evaluation.
HELPIN_PROXY=
# Optional email Let's Encrypt uses for certificate expiry notices (builtin only).
ACME_EMAIL=
# Bundled proxy network. Change only if 172.30.255.0/28 collides with a network
# on this host. EDGE_PROXY_IP must be inside EDGE_SUBNET but outside
# EDGE_IP_RANGE (used for the other services); then rerun helpin configure.
EDGE_SUBNET=172.30.255.0/28
EDGE_IP_RANGE=172.30.255.8/29
EDGE_PROXY_IP=172.30.255.2
DASHBOARD_PORT=8085
HELPCENTER_PORT=8086
STORAGE_PORT=9005
APP_BASE_URL=http://localhost:8085
PUBLIC_WIDGET_URL=http://localhost:8085
PUBLIC_SDK_URL=http://localhost:8085/sdk/lib.js
PUBLIC_STORAGE_URL=http://localhost:9005
# Help-center slug is created in workspace settings; ?subdomain=slug works locally.
HC_SUBDOMAIN=demo
AUTH_EMAIL_VERIFICATION_REQUIRED=false
# Public read-only demo login (leave empty to disable /demo).
DEMO_VIEWER_EMAIL=
DEMO_REQUIRE_EMAIL=false
DEMO_LEAD_WEBHOOK_URL=
HELPIN_ENABLED_MODULES=support,docs,agents,pm,crm,automation
POSTGRES_PASSWORD=GENERATE
HELPIN_DB_PASSWORD=GENERATE
RUNTIME_DB_PASSWORD=GENERATE
TEMPORAL_DB_PASSWORD=GENERATE
VISIBILITY_DB_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
GARAGE_ACCESS_KEY=GENERATE_GARAGE_ACCESS_KEY
GARAGE_SECRET_KEY=GENERATE
GARAGE_RPC_SECRET=GENERATE
JWT_SECRET=GENERATE
INTERNAL_API_SECRET=GENERATE
AGENT_RUNTIME_SERVICE_TOKEN=GENERATE
# These encryption keys are distinct. Keep stable and back them up with the databases.
AI_CONNECTION_ENCRYPTION_KEY=GENERATE
AGENT_RUNTIME_MODEL_CREDENTIAL_ENCRYPTION_KEY=GENERATE_BASE64
AGENT_RUNTIME_MCP_CREDENTIAL_ENCRYPTION_KEY=GENERATE_BASE64
# CRM mail/calendar tokens (also the fallback for TOTP and PM import secrets)
# and stored Git provider tokens.
CRM_ENCRYPTION_KEY=GENERATE
GIT_OAUTH_ENCRYPTION_KEY=GENERATE
# Tokens for external A2A agents (Settings > External agents).
EXTERNAL_A2A_ENCRYPTION_KEY=GENERATE
# Optional exact or *.domain hosts of external agents on a private network (plain HTTP allowed).
EXTERNAL_A2A_ALLOWED_PRIVATE_HOSTS=
# Optional application mail; does not configure support inbound/reply email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
# Agent API-key connections are configured in Settings > AI, not Runtime env.
CHATGPT_CONNECTIONS_ENABLED=false
AGENT_RUNTIME_CHATGPT_ENABLED=false
# Separate retrieval/global AI configuration, optional.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# User-added MCP endpoints: opt in deliberately for HTTP/private LAN servers.
AGENT_RUNTIME_MCP_ALLOW_HTTP=false
AGENT_RUNTIME_MCP_ALLOW_PRIVATE_NETWORKS=false
AGENT_RUNTIME_MCP_ALLOWED_HOSTS=
# No telemetry endpoint by default.
SENTRY_DSN=

# Optional CRM meeting capture (helpin configure sets these). Provider: recall
# (empty) or vexa. Webhooks go to APP_BASE_URL/api/webhooks/meeting-capture/<provider>,
# so APP_BASE_URL must be public https. Empty base URLs use the hosted APIs.
CRM_MEETING_CAPTURE_PROVIDER=
RECALL_BASE_URL=
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
VEXA_BASE_URL=
VEXA_API_KEY=
VEXA_WEBHOOK_SECRET=
# Optional Google OAuth client for Gmail and Google Calendar. Empty redirect
# means APP_BASE_URL/api/crm/email/oauth/callback; register that with Google.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URL=

# Generous authenticated API/MCP minute ceilings; 0 disables the corresponding limit.
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=1200
EXPENSIVE_RATE_LIMIT_PER_MINUTE=120

# Optional external review sends selected command/repository context to TypeSafe.
# Keep automatic approval disabled until the runtime live evaluations pass.
TYPESAFE_API_KEY=
AGENT_RUNTIME_TYPESAFE_ENABLED=false
AGENT_RUNTIME_TYPESAFE_AUTO_APPROVE=false
AGENT_RUNTIME_TYPESAFE_ASKED_THRESHOLD=0.90
AGENT_RUNTIME_TYPESAFE_HAZARD_THRESHOLD=0.20
AGENT_RUNTIME_TYPESAFE_ESCALATION_THRESHOLD=0.50
AGENT_RUNTIME_TYPESAFE_MODEL=jev-latest
AGENT_RUNTIME_TYPESAFE_EVALUATED_MODEL=jev-1.13.0
