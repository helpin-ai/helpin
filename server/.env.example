DATABASE_URL=postgres://helpin:helpin@localhost:5432/helpin?sslmode=disable
JWT_SECRET=change-this-to-a-secure-secret
PORT=8080
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Sentry
SENTRY_DSN=https://313588e74d7c61c42a9a16c3f7ec019e@sen.usrmvn.com/6
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_SERVER_NAME=

# Realtime relay (required for cross-process planning streams and worker events)
NATS_URL=nats://localhost:4222

# Anthropic API (optional — agent/orchestration features disabled if not set)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=

# Website Content Crawler
CRAWLER_MODE=cloudflare_with_fallback  # Options: cloudflare, local, cloudflare_with_fallback
CRAWLER_PROXY_URLS=  # Comma-separated proxy URLs for the local Colly crawler
# Decodo residential example: http://<user>:<pass>@gate.decodo.com:10001
# Decodo datacenter example:  http://<user>:<pass>@gate.decodo.com:10000

# GitHub App (optional — required for shared-runner repo mutation)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=  # base64-encoded PEM

# S3 / Object Storage (optional — attachments disabled if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # For MinIO: http://localhost:9000
AWS_S3_PUBLIC_BASE_URL=  # For R2/custom CDN: https://assets.example.com or https://<bucket>.r2.dev

# Postmark email (optional — invitation emails logged only if not set)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_INBOUND_WEBHOOK_SECRET=
SUPPORT_EMAIL_REPLY_DOMAIN=replies.helpin.ai

# Gmail OAuth (optional — CRM email sync disabled if not set)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URL=http://localhost:8080/api/crm/email/oauth/callback
CRM_ENCRYPTION_KEY=  # 32-byte hex-encoded AES key (generate: openssl rand -hex 32)

# CRM LLM Provider for signal detection (optional — defaults to claude using ANTHROPIC_API_KEY)
CRM_LLM_PROVIDER=claude  # "claude" or "openai"
CRM_LLM_API_KEY=
CRM_LLM_BASE_URL=        # For OpenAI-compatible endpoints
CRM_LLM_MODEL=gpt-4o     # Model name for OpenAI provider

# Query expansion for support AI RAG pipeline (optional — defaults shown)
QUERY_EXPANSION_MODEL=gpt-5.4-mini
QUERY_EXPANSION_PROVIDER=openai

# Redis (optional — empty = local-only mode, set for multi-pod WebSocket scaling)
REDIS_URL=redis://localhost:6379/0

# NATS (optional — JetStream-enabled NATS for event streaming and AI agent communication)
NATS_URL=nats://localhost:4222
