DATABASE_URL=postgres://helpin:helpin@localhost:5432/helpin?sslmode=disable
JWT_SECRET=change-this-to-a-secure-secret
PORT=8080
LOG_LEVEL=info
RUN_AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
MOBILE_APP_BASE_URL=http://localhost:5176 # Hosted support-mobile OAuth return origin, e.g. https://azhar.dev.helpin.ai
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Google account sign-in
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Stripe Billing
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
BILLING_TEST_SCENARIOS_ENABLED=false

# Customer.io Track API (server-side identity and object sync)
CUSTOMER_IO_SITE_ID=
CUSTOMER_IO_TRACK_API_KEY=
CUSTOMER_IO_REGION=us
CUSTOMER_IO_WORKSPACE_OBJECT_TYPE_ID=1
CUSTOMER_IO_ORGANIZATION_OBJECT_TYPE_ID=2

# Usermaven server-side product analytics (optional)
USERMAVEN_API_KEY=
USERMAVEN_SERVER_TOKEN=
USERMAVEN_ENDPOINT=https://events.usermaven.com/api/v1/s2s/event
# Optional native ClickHouse DSN for CRM behavioral signal evaluation.
# Leave empty for core backend development. Run `just events-up` and set the
# local DSN below when developing the behavioral event pipeline.
CLICKHOUSE_DSN=
# CLICKHOUSE_DSN=clickhouse://helpin:helpin@127.0.0.1:9000/usermaven
# Stable Kafka consumer group used by the ClickHouse Kafka table.
CLICKHOUSE_KAFKA_GROUP=helpin-clickhouse-local-v1
# Deployment jobs set this to prevent falling back to local Kafka defaults.
CLICKHOUSE_MIGRATION_REQUIRE_KAFKA_CONFIG=false

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_SERVER_NAME=

# Realtime relay (required for cross-process planning streams and worker events)
NATS_URL=nats://localhost:4222

# Setup & Success guide rollout (coordinate with frontend VITE_SETUP_SUCCESS_ENABLED)
SETUP_SUCCESS_ENABLED=false

# Anthropic API (optional — agent/orchestration features disabled if not set)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
DOCS_IMPORT_AI_CONVERSION_ENABLED=false
DOCS_IMPORT_AI_CONVERSION_PROVIDER=openrouter
DOCS_IMPORT_AI_CONVERSION_MODEL=deepseek/deepseek-v4-flash-0731
DOCS_IMPORT_AI_CONVERSION_ARTICLE_LIMIT=0
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Help center AI answers (public search page). Defaults to a flash-tier model
# on the first configured chat provider key (openrouter > openai > anthropic);
# with no chat key at all, answers degrade to article results.
HELPCENTER_ANSWER_PROVIDER=
HELPCENTER_ANSWER_MODEL=
CODEX_OPENAI_AUTH_MODE=api_key  # "api_key", "chatgpt_oauth", or "chatgpt_device_code"
CODEX_ENABLE_CHATGPT_OAUTH=false
CODEX_CHATGPT_ACCESS_TOKEN=
CODEX_CHATGPT_ACCOUNT_ID=
MCP_PUBLIC_BASE_URL=  # Public origin for hosted MCP/OAuth metadata, e.g. https://mcp.helpin.ai. Defaults to APP_BASE_URL.
MCP_SERVER_ENABLED=true  # Platform kill switch. Enabled by default; set false to turn off public MCP in an environment.
MCP_OAUTH_ENABLED=true
MCP_SERVICE_TOKENS_ENABLED=true
MCP_PM_WRITE_ENABLED=true
MCP_DOCS_WRITE_ENABLED=true
MCP_AGENT_RUN_ENABLED=true
MCP_CRM_ENABLED=true
MCP_SUPPORT_ENABLED=true

# Outbound workspace MCP integrations. OAuth tokens and static credentials are
# encrypted by Helpin and only short-lived credentials are attached per run.
EXTERNAL_MCP_ENABLED=false
EXTERNAL_MCP_ENCRYPTION_KEY=  # Required when enabled: 32 raw bytes, 64 hex chars, or base64-encoded 32 bytes.
EXTERNAL_MCP_ALLOWED_HOSTS=*  # Any public HTTPS host by default; set exact or *.domain patterns to restrict.
EXTERNAL_MCP_OAUTH_REDIRECT_URL=  # Public API callback, e.g. https://api.example.com/api/external-mcp/oauth/callback
EXTERNAL_MCP_OAUTH_CLIENT_ID=  # Optional pre-registered OAuth client; dynamic registration is used when empty.
EXTERNAL_MCP_OAUTH_CLIENT_SECRET=
EXTERNAL_MCP_OAUTH_CLIENT_AUTH_METHOD=none
EXTERNAL_MCP_ALLOW_INSECURE_LOCALHOST=false  # Development tests only.
TLS_ASK_EXTRA_ALLOWED_DOMAINS=  # Optional; extra hostnames the Caddy on-demand TLS ask endpoint approves. Comma-separated; ".suffix" or "*.suffix" entries match subdomains.
TOTP_ENCRYPTION_KEY=        # 32-byte hex-encoded AES key for stored user TOTP secrets/recovery codes (falls back to CRM_ENCRYPTION_KEY if empty)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=

# Agent Runtime execution. Agent Runtime is the only agent executor; Helpin has
# no in-process fallback. Keep this enabled anywhere agent runs are supported.
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090  # Staging (in-cluster): http://agent-runtime.agent-runtime.svc.cluster.local:8090
AGENT_RUNTIME_SERVICE_TOKEN=dev-token  # Bearer token for calls TO agent-runtime; must equal the runtime's AGENT_RUNTIME_SERVICE_TOKEN (the runtime fails closed without one)
AGENT_RUNTIME_APP_ID=helpin  # App partition id in agent-runtime; must match the "app_id" entry in the runtime's AGENT_RUNTIME_APP_CONFIG
AGENT_RUNTIME_EVENT_PROTOCOL=v2  # Durable ordered event contract; v1 remains available for legacy apps such as Usermaven
AGENT_RUNTIME_LAUNCH_ENABLED=true  # Required for agent execution. If false/unset, new runs fail loudly; there is no local executor fallback.
INTERNAL_API_SECRET=  # Bearer secret protecting /api/internal/* (incl. agent-runtime host adapter callbacks); the runtime's helpin app-config tokens must carry this exact value

# Website Content Crawler
CRAWLER_MODE=cloudflare_with_fallback  # Options: cloudflare, local, cloudflare_with_fallback
CRAWLER_PROXY_URLS=http://<user>:<pass>@isp.decodo.com:10001  # Smartproxy/Decodo proxy for crawler plus agent fetch_url/crawl_url; add more URLs comma-separated if needed
GOOGLE_WEB_RISK_API_KEY=

# GitHub App (optional — required for shared-runner repo mutation)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=  # base64-encoded PEM

## GitLab is connected per organization via a Personal/Group/Project Access Token
## entered in the UI — no server-side OAuth app is required.
GIT_OAUTH_ENCRYPTION_KEY=  # 32-byte hex-encoded AES key for stored git provider tokens (falls back to CRM_ENCRYPTION_KEY)

# S3 / Object Storage (optional — attachments disabled if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # S3-compatible endpoint, e.g. http://garage:3900
AWS_S3_PRIVATE_BUCKET=false  # true for Garage: ACL-free private storage and explicit public asset routes
AWS_S3_PUBLIC_BASE_URL=  # For R2/custom CDN: https://assets.example.com or https://<bucket>.r2.dev

# Postmark email
# Legacy single-server variables are still supported as fallbacks:
# POSTMARK_SERVER_TOKEN, POSTMARK_FROM_EMAIL, POSTMARK_INBOUND_WEBHOOK_SECRET
#
# Account token for creating/verifying custom sender domains.
POSTMARK_ACCOUNT_TOKEN=
#
# App / product email (helpin.ai)
POSTMARK_APP_SERVER_TOKEN=
POSTMARK_APP_FROM_EMAIL=notifications@helpin.ai
#
# Support replies (helpin.email)
# Reply and route domains stay separate so threaded replies and new inbound routes can use different Postmark streams.
POSTMARK_REPLY_SERVER_TOKEN=
POSTMARK_REPLY_FROM_EMAIL=support@helpin.email
POSTMARK_REPLY_INBOUND_WEBHOOK_SECRET=
SUPPORT_EMAIL_REPLY_DOMAIN=replies.helpin.email
#
# Support forwarding routes (helpin.email)
POSTMARK_ROUTE_SERVER_TOKEN=
POSTMARK_ROUTE_INBOUND_WEBHOOK_SECRET=
SUPPORT_EMAIL_ROUTE_DOMAIN=on.helpin.email

# Gmail OAuth (optional — CRM email sync disabled if not set)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URL=http://localhost:8080/api/crm/email/oauth/callback
CRM_ENCRYPTION_KEY=  # 32-byte hex-encoded AES key (generate: openssl rand -hex 32)

# Firebase Cloud Messaging (optional — mobile push notifications disabled if unset)
FCM_SERVICE_ACCOUNT_JSON=  # full service-account JSON (as a single-line string), used with option.WithCredentialsJSON

# Optional CRM direct-completion route overrides. Leave empty to use:
# primary=openrouter/deepseek/deepseek-v4-flash-0731
# fallback=openrouter/openai/gpt-5.6-luna
# meeting fallback=openrouter/google/gemini-3.7-flash
# Provider/model values must be set as pairs and must exist in the pricing catalog.
CRM_LLM_PROVIDER=
CRM_LLM_MODEL=
# Optional OpenRouter infrastructure provider slug, e.g. together or google-vertex/global.
# This pins the route with allow_fallbacks=false; empty lets OpenRouter choose.
CRM_LLM_OPENROUTER_PROVIDER=
CRM_LLM_FALLBACK_PROVIDER=
CRM_LLM_FALLBACK_MODEL=
CRM_LLM_FALLBACK_OPENROUTER_PROVIDER=
CRM_MEETING_LLM_FALLBACK_PROVIDER=
CRM_MEETING_LLM_FALLBACK_MODEL=
CRM_MEETING_LLM_FALLBACK_OPENROUTER_PROVIDER=

# Meeting Intelligence capture provider. Deployment-owned; not user-configurable.
# Supported values: recall, vexa
CRM_MEETING_CAPTURE_PROVIDER=recall

# Recall configuration.
# Register Recall webhooks at: <API_BASE_URL>/api/webhooks/meeting-capture/recall
RECALL_BASE_URL=https://us-east-1.recall.ai
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Optional Vexa adapter for a later hosted or self-hosted provider switch.
# Configure PUT /user/webhook for <API_BASE_URL>/api/webhooks/meeting-capture/vexa.
# Current webhook.v1 deliveries sign <timestamp>.<raw-body> with HMAC-SHA256
# using VEXA_WEBHOOK_SECRET. Legacy bearer-secret deliveries remain accepted.
# New captures use CRM_MEETING_CAPTURE_PROVIDER; in-flight captures keep their original provider.
VEXA_BASE_URL=https://api.cloud.vexa.ai
VEXA_API_KEY=
VEXA_WEBHOOK_SECRET=

# Query expansion for support AI RAG pipeline (optional — defaults shown)
QUERY_EXPANSION_PROVIDER=openai
QUERY_EXPANSION_MODEL=gpt-5.6-luna
QUERY_EXPANSION_TIMEOUT_MS=10000

# Command bar semantic router (optional — defaults shown)
COMMAND_ROUTER_LLM_PROVIDER=openrouter
COMMAND_ROUTER_LLM_MODEL=google/gemini-3.1-flash-lite
COMMAND_ROUTER_LLM_MAX_TOKENS=900
COMMAND_ROUTER_LLM_TIMEOUT_MS=8000
# Optional OpenRouter provider routing object, used only when COMMAND_ROUTER_LLM_PROVIDER=openrouter.
COMMAND_ROUTER_OPENROUTER_PROVIDER_OPTIONS={"order":["google-vertex/global"],"allow_fallbacks":false}
# Example for GLM-4.7 on Cerebras only:
# COMMAND_ROUTER_LLM_MODEL=z-ai/glm-4.7
# COMMAND_ROUTER_OPENROUTER_PROVIDER_OPTIONS={"order":["cerebras"],"allow_fallbacks":false}

# MaxMind GeoIP configuration (optional — missing DBs download in the background).
# The API starts without GeoIP while unavailable, retrying hourly until loaded.
# HTTP 429 retries wait at least 12 hours; longer Retry-After headers are respected.
# Existing DBs are reused; the API does not periodically refresh a loaded DB.
MAXMIND_ACCOUNT_ID=
MAXMIND_DB_PATH=
MAXMIND_DOWNLOAD_URL=
MAXMIND_LICENSE_KEY=

# Redis (optional — empty = local-only mode, set for multi-pod WebSocket scaling)
# Local Docker Compose default password: helpin-redis-dev
REDIS_URL=redis://:helpin-redis-dev@localhost:6379/0

# Agent preview diagnostics (optional — enables detailed logs for story-plan preview persistence/apply)
AGENT_PREVIEW_DEBUG=false

# Native SDK planner selective skill activation.
# Default is enabled. Set to false in Temporal worker env to temporarily roll back eligible native planner runs.
AGENT_NATIVE_SELECTIVE_PLANNER_ENABLED=true

# NATS (optional — JetStream-enabled NATS for event streaming and AI agent communication)
NATS_URL=nats://localhost:4222

# Shared/personal AI connections. Stable app-owned encryption key (32 raw bytes,
# 64 hex characters, or base64 encoding of 32 bytes). Runtime needs its own key.
# Required on EE API and every EE worker; Community profiles also need this key.
AI_CONNECTION_ENCRYPTION_KEY=
# Opt-in after live subscription validation. Agent profiles send run credentials;
# Runtime global keys remain available only to apps whose policy permits defaults.
CHATGPT_CONNECTIONS_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=

# Optional local semantic triage. Off by default; see decision-engine/docs/LOCAL_ROUTING_ROLLOUT.md.
SUPPORT_DECISION_MODE=off
SUPPORT_DECISION_URL=
SUPPORT_DECISION_TOKEN=
SUPPORT_DECISION_TIMEOUT_MS=200
SUPPORT_DECISION_WORKSPACE_IDS=
SUPPORT_DECISION_POLICIES=
# Local CLI OAuth and admission rollout (model gateway is a subsequent phase).
CLI_ENABLED=false
# Public origin used for CLI discovery, OAuth issuer and API resource.
# Required when enabled: the API origin serving CLI discovery (not the frontend).
# CLI_PUBLIC_BASE_URL=https://api.helpin.ai

# Enable only after the compatible CLI and gateway adapter are deployed.
CLI_MODEL_GATEWAY_ENABLED=false

# Generous authenticated API/MCP minute ceilings; 0 disables the corresponding limit.
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=1200
EXPENSIVE_RATE_LIMIT_PER_MINUTE=120

# Jev routing, tags, human handoff and follow-up classification. Primary when key is set.
# No key: existing LLM/manual behavior. Each feature supports primary, shadow and off.
JEV_API_KEY=
JEV_ROUTING_MODE=primary
JEV_TAGS_MODE=primary
JEV_HANDOFF_MODE=primary
JEV_FOLLOW_UP_MODE=primary
JEV_TIMEOUT_MS=1000
# Empty means all workspaces; comma-separated IDs restrict the rollout.
JEV_WORKSPACE_IDS=
# Provisional provider-probability thresholds, not calibrated correctness guarantees.
JEV_ROUTING_THRESHOLD=0.90
JEV_TAG_THRESHOLD=0.95
JEV_HANDOFF_THRESHOLD=0.95
JEV_FOLLOW_UP_THRESHOLD=0.95
# Combined calls across all four decisions per workspace/day, including failed attempts.
JEV_DAILY_LIMIT=1000
