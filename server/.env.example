DATABASE_URL=postgres://user:password@localhost:5432/helpin?sslmode=disable
JWT_SECRET=change-this-to-a-secure-secret
PORT=8080
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_SERVER_NAME=

# Anthropic API (optional — agent/orchestration features disabled if not set)
ANTHROPIC_API_KEY=

# GitHub App (optional — required for shared-runner repo mutation)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=  # base64-encoded PEM

# S3 / Object Storage (optional — attachments disabled if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # For MinIO: http://localhost:9000

# Postmark email (optional — invitation emails logged only if not set)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
