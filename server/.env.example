DATABASE_URL=postgres://user:password@localhost:5432/helpin?sslmode=disable
JWT_SECRET=change-this-to-a-secure-secret
PORT=8080
# CORS origins are hardcoded in config.go (app.helpin.ai, stage.helpin.ai, localhost:5173)

# S3 / Object Storage (optional — attachments disabled if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # For MinIO: http://localhost:9000

# Postmark email (optional — invitation emails logged only if not set)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
APP_BASE_URL=http://localhost:5173
