# Copy this file to .env.r2 and chmod 600. Never commit the populated file.
# Create an R2 Object Read & Write token scoped only to helpin-clickhouse, then
# use the generated S3 credentials (not a general Cloudflare API bearer token).
CLICKHOUSE_R2_ACCESS_KEY_ID=
CLICKHOUSE_R2_SECRET_ACCESS_KEY=
CLICKHOUSE_R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com/<bucket>
