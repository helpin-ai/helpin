# Application
APP_ENV=dev
LOG_LEVEL=INFO
PRINT_SINK=true

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=helpin.events.raw
KAFKA_TRANSFORMATION_TOPIC=helpin.events.enriched
KAFKA_TRANSFORMATION_ERROR_TOPIC=helpin.events.enriched.dlq
KAFKA_SESSIONIZED_TOPIC=helpin.events.sessionized
KAFKA_AUTH=false
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL=SCRAM-SHA-512
KAFKA_USERNAME=helpin-eventpipeline
KAFKA_PASSWORD=

# Auth (Go backend token endpoint)
HTTP_TOKENS_URL=http://localhost:8080/api/internal/widget-tokens
INTERNAL_API_SECRET=

# MaxMind GeoIP
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# MAXMIND_DOWNLOAD_URL=https://download.maxmind.com/geoip/databases/GeoLite2-City/download?suffix=tar.gz
# MAXMIND_DB_PATH=data/GeoLite2-City.mmdb

# IP2Proxy
IP2PROXY_DOWNLOADER_URL=http://localhost:8081

# Monitoring (optional)
# SENTRY_DSN=
# TRACES_SAMPLE_RATE=0.1

# Replay worker (optional — defaults are sane)
# FALLBACK_DIR=data/fallback
# REPLAY_BATCH_SIZE=100
# REPLAY_POLL_INTERVAL_SECS=5
# REPLAY_CLEANUP_HOURS=24
