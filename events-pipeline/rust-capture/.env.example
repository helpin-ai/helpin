# Application
APP_ENV=dev
LOG_LEVEL=INFO
PRINT_SINK=true
NETWORK_ENRICHMENT_ENABLED=false

# Dedicated JetStream cluster
NATS_URL=nats://localhost:4222
# NATS_USERNAME=capture
# NATS_PASSWORD=
# NATS_CA_FILE=/etc/nats/tls/ca.crt
# NATS_CLIENT_CERT_FILE=/etc/nats/tls/tls.crt
# NATS_CLIENT_KEY_FILE=/etc/nats/tls/tls.key
NATS_WORK_PUBLISH_TIMEOUT_MS=1500
NATS_ARCHIVE_PUBLISH_TIMEOUT_MS=250
NATS_DLQ_PUBLISH_TIMEOUT_MS=1500
EVENTS_WORK_MAX_BYTES=10737418240
EVENTS_WORK_COMPRESSION=s2
EVENTS_RAW_MAX_BYTES=2147483648
EVENTS_DLQ_MAX_BYTES=1073741824

# Session writer
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_DATABASE=usermaven
CLICKHOUSE_USER=helpin
CLICKHOUSE_PASSWORD=helpin
WRITER_REPLICAS=4
SESSION_CACHE_MAX_ENTRIES_PER_SHARD=100000
# WRITER_ORDINAL=0 # derived from StatefulSet POD_NAME in Kubernetes

# Auth (Go backend token endpoint)
HTTP_TOKENS_URL=http://localhost:8080/api/internal/widget-tokens
INTERNAL_API_SECRET=

# MaxMind GeoIP
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# MAXMIND_DB_PATH=data/GeoLite2-City.mmdb
# MAXMIND_TEMP_DIR=temp_data/maxmind
# MAXMIND_DOWNLOAD_URL=https://download.maxmind.com/geoip/databases/GeoLite2-City/download?suffix=tar.gz

# IP2Proxy
IP2PROXY_DOWNLOADER_URL=http://localhost:8081
# IP2PROXY_DB_PATH=data/IP2PROXY-IP-PROXYTYPE-COUNTRY.BIN
# MAXMIND_DB_REFRESH_INTERVAL_SECS=43200
# IP2PROXY_DB_REFRESH_INTERVAL_SECS=86400

# Monitoring
# SENTRY_DSN=
# TRACES_SAMPLE_RATE=0.1

# Encrypted persistent spill and replay
# FALLBACK_DIR=data/fallback
# REPLAY_BATCH_SIZE=100
# REPLAY_POLL_INTERVAL_SECS=5
# REPLAY_CLEANUP_HOURS=24
